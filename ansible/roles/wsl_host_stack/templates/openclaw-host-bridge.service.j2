[Unit]
Description=OpenClaw Host Bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ openclaw_bridge_user }}
WorkingDirectory={{ openclaw_host_bridge_root }}
EnvironmentFile=/etc/openclaw/host-bridge/openclaw-host-bridge.env
ExecStart={{ openclaw_host_bridge_root }}/scripts/run-openclaw-host-bridge-supervisor.sh
Restart=always
RestartSec=5

[Install]
WantedBy={{ openclaw_stack_target_name }}
