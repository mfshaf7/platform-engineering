[Unit]
Description=OpenClaw Host Recovery
After=network-online.target {{ openclaw_bridge_service_name }}
Wants=network-online.target

[Service]
Type=simple
User={{ openclaw_bridge_user }}
WorkingDirectory={{ openclaw_host_bridge_root }}
EnvironmentFile=/etc/openclaw/host-bridge/openclaw-host-bridge.env
ExecStart={{ openclaw_host_bridge_root }}/scripts/run-openclaw-host-recovery-supervisor.sh
Restart=always
RestartSec=5

[Install]
WantedBy={{ openclaw_stack_target_name }}
