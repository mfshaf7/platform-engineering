param(
  [string]$TaskName = '{{ platform_windows_task_name }}',
  [string]$Distro = '{{ platform_windows_wsl_distro }}',
  [string]$Root = '{{ openclaw_host_bridge_root }}',
  [string]$StackTarget = '{{ openclaw_stack_target_name }}',
  [string]$BridgeService = '{{ openclaw_bridge_service_name }}',
  [string]$RecoveryService = '{{ openclaw_recovery_service_name }}',
  [string]$PlatformVaultUnsealEnabled = '{{ platform_windows_vault_unseal_enabled | lower }}',
  [string]$TransitMode = '{{ platform_transit_mode }}',
  [string]$TransitDistro = '{{ platform_transit_windows_wsl_distro }}',
  [string]$TransitVaultService = '{{ platform_transit_vault_service_name }}',
  [string]$TransitVaultHealthUrl = '{{ platform_transit_vault_health_url }}',
  [string]$TransitVaultProxyName = '{{ platform_transit_vault_windows_proxy_name }}',
  [int]$TransitVaultProxyPort = {{ platform_transit_vault_windows_proxy_port }},
  [int]$TransitVaultStartTimeoutSeconds = {{ platform_transit_vault_start_timeout_seconds }},
  [int]$TransitVaultUnsealWaitTimeoutSeconds = {{ platform_transit_vault_unseal_wait_timeout_seconds }},
  [string]$TransitUnsealEnabled = '{{ platform_transit_windows_unseal_enabled | lower }}',
  [switch]$RunBootstrapOnly
)

$ErrorActionPreference = 'Stop'

$wslCommand = "systemctl start $StackTarget && systemctl --quiet is-active $StackTarget $BridgeService $RecoveryService"

$forwardPorts = @(
{% for port in platform_windows_localhost_forward_ports %}
  {{ port }}{{ "," if not loop.last else "" }}
{% endfor %}
)

$hostForwardRules = @(
{% for rule in platform_windows_host_forward_rules | default([]) %}
  @{
    Name = '{{ rule.name }}'
    ListenAddressSource = '{{ rule.listen_address_source }}'
    ListenAddressAliases = @(
{% for alias in rule.listen_address_aliases | default([]) %}
      '{{ alias }}'{{ "," if not loop.last else "" }}
{% endfor %}
    )
    ListenPort = {{ rule.listen_port }}
    ConnectAddress = '{{ rule.connect_address }}'
    ConnectPort = {{ rule.connect_port }}
  }{{ "," if not loop.last else "" }}
{% endfor %}
)

function Test-WslDistroExists {
  param([string]$Name)

  $distros = (wsl.exe -l -q) -split "`r?`n" | ForEach-Object { $_.Trim() } | Where-Object { $_ }
  return $distros -contains $Name
}

function Invoke-WslBash {
  param(
    [string]$TargetDistro,
    [string]$Command,
    [string]$WorkingDirectory = ""
  )

  if ($WorkingDirectory) {
    return wsl.exe -d $TargetDistro -u root --cd $WorkingDirectory /bin/bash -lc $Command
  }

  return wsl.exe -d $TargetDistro -u root -- sh -lc $Command
}

function Get-WslHostDockerInternalIp {
  $resolved = Invoke-WslBash -TargetDistro $Distro -Command "getent hosts host.docker.internal | awk '{print `$1; exit}'"
  $ip = $resolved.Trim()
  if (-not $ip) {
    throw "Unable to resolve host.docker.internal from $Distro"
  }

  return $ip
}

function Get-TransitWslIp {
  $resolved = (Invoke-WslBash -TargetDistro $TransitDistro -Command "hostname -I").Trim().Split(" ", [System.StringSplitOptions]::RemoveEmptyEntries)[0]
  if (-not $resolved) {
    throw "Unable to determine WSL IP for transit distro $TransitDistro"
  }

  return $resolved
}

function Update-LocalhostPortProxy {
  $wslIp = (Invoke-WslBash -TargetDistro $Distro -Command "hostname -I").Trim().Split(" ", [System.StringSplitOptions]::RemoveEmptyEntries)[0]
  if (-not $wslIp) {
    throw "Unable to determine WSL IP for $Distro"
  }

  foreach ($port in $forwardPorts) {
    netsh interface portproxy delete v4tov4 listenport=$port listenaddress=127.0.0.1 | Out-Null
    netsh interface portproxy add v4tov4 listenport=$port listenaddress=127.0.0.1 connectport=$port connectaddress=$wslIp | Out-Null
  }

  $hostDockerInternalIp = $null

  foreach ($rule in $hostForwardRules) {
    $listenAddress = switch ($rule.ListenAddressSource) {
      'wsl_host_docker_internal' {
        if (-not $hostDockerInternalIp) {
          $hostDockerInternalIp = Get-WslHostDockerInternalIp
        }
        $hostDockerInternalIp
      }
      default {
        throw "Unsupported listen address source: $($rule.ListenAddressSource)"
      }
    }

    netsh interface portproxy delete v4tov4 listenport=$($rule.ListenPort) listenaddress=$listenAddress | Out-Null
    foreach ($listenAddressAlias in $rule.ListenAddressAliases) {
      if ($listenAddressAlias) {
        netsh interface portproxy delete v4tov4 listenport=$($rule.ListenPort) listenaddress=$listenAddressAlias | Out-Null
      }
    }
    netsh interface portproxy add v4tov4 listenport=$($rule.ListenPort) listenaddress=$listenAddress connectport=$($rule.ConnectPort) connectaddress=$($rule.ConnectAddress) | Out-Null

    $existingRule = Get-NetFirewallRule -DisplayName $rule.Name -ErrorAction SilentlyContinue
    if (-not $existingRule) {
      New-NetFirewallRule `
        -DisplayName $rule.Name `
        -Direction Inbound `
        -Action Allow `
        -Protocol TCP `
        -LocalPort $rule.ListenPort `
        -Profile Any | Out-Null
    }
  }
}

function Update-TransitVaultPortProxy {
  if ($TransitMode -eq 'disabled') {
    return
  }

  $listenAddress = Get-WslHostDockerInternalIp
  $transitIp = Get-TransitWslIp

  netsh interface portproxy delete v4tov4 listenport=$TransitVaultProxyPort listenaddress=$listenAddress | Out-Null
  netsh interface portproxy add v4tov4 listenport=$TransitVaultProxyPort listenaddress=$listenAddress connectport=8200 connectaddress=$transitIp | Out-Null

  $existingRule = Get-NetFirewallRule -DisplayName $TransitVaultProxyName -ErrorAction SilentlyContinue
  if (-not $existingRule) {
    New-NetFirewallRule `
      -DisplayName $TransitVaultProxyName `
      -Direction Inbound `
      -Action Allow `
      -Protocol TCP `
      -LocalPort $TransitVaultProxyPort `
      -Profile Any | Out-Null
  }
}

function Invoke-TransitVaultUnseal {
  if ($TransitUnsealEnabled -ne 'true') {
    return
  }

  if (-not $PSScriptRoot) {
    throw "Unable to determine script root for transit unseal helper."
  }

  $helperPath = Join-Path $PSScriptRoot 'openclaw-transit-vault-unseal.ps1'
  if (-not (Test-Path -LiteralPath $helperPath)) {
    throw "Transit unseal helper not found at $helperPath."
  }

  & powershell.exe -NoProfile -ExecutionPolicy Bypass -File $helperPath
}

function Invoke-PlatformVaultUnseal {
  if ($PlatformVaultUnsealEnabled -ne 'true') {
    return
  }

  if (-not $PSScriptRoot) {
    throw "Unable to determine script root for platform Vault unseal helper."
  }

  $helperPath = Join-Path $PSScriptRoot 'platform-vault-unseal.ps1'
  if (-not (Test-Path -LiteralPath $helperPath)) {
    throw "Platform Vault unseal helper not found at $helperPath."
  }

  & powershell.exe -NoProfile -ExecutionPolicy Bypass -File $helperPath
}

function Start-TransitVault {
  if ($TransitMode -eq 'disabled') {
    return
  }

  if (-not (Test-WslDistroExists -Name $TransitDistro)) {
    throw "Transit distro '$TransitDistro' is not registered."
  }

  Invoke-WslBash -TargetDistro $TransitDistro -Command "systemctl start $TransitVaultService && systemctl --quiet is-active $TransitVaultService" | Out-Null
  Invoke-TransitVaultUnseal

  $deadline = (Get-Date).AddSeconds($TransitVaultStartTimeoutSeconds)
  while ((Get-Date) -lt $deadline) {
    try {
      Invoke-WslBash -TargetDistro $TransitDistro -Command "curl -fsS '$TransitVaultHealthUrl' >/dev/null" | Out-Null
      Update-TransitVaultPortProxy
      return
    } catch {
      Start-Sleep -Seconds 2
    }
  }

  throw "Transit Vault did not become healthy within $TransitVaultStartTimeoutSeconds seconds."
}

function Wait-ForWorkloadVaultUnsealed {
  if ($TransitMode -ne 'cold') {
    return
  }

  $deadline = (Get-Date).AddSeconds($TransitVaultUnsealWaitTimeoutSeconds)
  while ((Get-Date) -lt $deadline) {
    try {
      $statusJson = Invoke-WslBash `
        -TargetDistro $Distro `
        -Command "KUBECONFIG=/etc/rancher/k3s/k3s.yaml /usr/local/bin/k3s kubectl -n vault exec vault-0 -- vault status -format=json"
      if ($statusJson -match '"sealed"\s*:\s*false') {
        return
      }
    } catch {
      # Retry until the timeout because k3s and vault may still be converging.
    }

    Start-Sleep -Seconds 3
  }

  throw "Workload Vault did not report unsealed within $TransitVaultUnsealWaitTimeoutSeconds seconds."
}

function Stop-TransitVault {
  if ($TransitMode -ne 'cold') {
    return
  }

  if (-not (Test-WslDistroExists -Name $TransitDistro)) {
    return
  }

  Invoke-WslBash -TargetDistro $TransitDistro -Command "systemctl stop $TransitVaultService" | Out-Null
}

function Invoke-PlatformCoreBootstrap {
  Invoke-WslBash -TargetDistro $Distro -WorkingDirectory $Root -Command $wslCommand | Out-Null
  Update-LocalhostPortProxy
}

function Invoke-Bootstrap {
  Start-TransitVault

  try {
    Invoke-PlatformCoreBootstrap
    Invoke-PlatformVaultUnseal
    Wait-ForWorkloadVaultUnsealed
  } finally {
    Stop-TransitVault
  }
}

if ($RunBootstrapOnly) {
  Invoke-Bootstrap
  Write-Output "Completed host bootstrap for $Distro"
  exit 0
}

if (-not $PSCommandPath) {
  throw "Unable to determine script path for scheduled task registration."
}

$taskArgs = "-NoProfile -ExecutionPolicy Bypass -File `"$PSCommandPath`" -RunBootstrapOnly"
$action = New-ScheduledTaskAction -Execute 'powershell.exe' -Argument $taskArgs
$trigger = New-ScheduledTaskTrigger -AtLogOn -User $env:USERNAME
$settings = New-ScheduledTaskSettingsSet `
  -AllowStartIfOnBatteries `
  -DontStopIfGoingOnBatteries `
  -MultipleInstances IgnoreNew `
  -StartWhenAvailable `
  -Hidden

$principal = New-ScheduledTaskPrincipal `
  -UserId $env:USERNAME `
  -LogonType Interactive `
  -RunLevel Highest

Register-ScheduledTask `
  -TaskName $TaskName `
  -Action $action `
  -Trigger $trigger `
  -Settings $settings `
  -Principal $principal `
  -Force | Out-Null

Start-ScheduledTask -TaskName $TaskName
Write-Output "Registered and started task: $TaskName"
