{
  "title": "Platform Overview",
  "tags": ["platform-engineering", "openclaw"],
  "uid": "platform-overview",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "panels": [
    {
      "type": "stat",
      "title": "Vault Ready Replicas",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "kube_statefulset_status_replicas_ready{namespace=\"vault\",statefulset=\"vault\"}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Gateway Pods Running",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum(kube_pod_status_phase{namespace=~\"openclaw|openclaw-stage\",pod=~\"openclaw-gateway-.*\",phase=\"Running\"})",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Healthy Scrape Targets",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 6 },
      "targets": [
        {
          "expr": "count(up == 1)",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Running Cluster Pods",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 6 },
      "targets": [
        {
          "expr": "count(kube_pod_status_phase{phase=\"Running\"} == 1)",
          "refId": "A"
        }
      ]
    }
  ]
}
