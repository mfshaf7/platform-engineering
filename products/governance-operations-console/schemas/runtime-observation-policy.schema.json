{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mfshaf7.github.io/platform-engineering/governance-operations-console/runtime-observation-policy.schema.json",
  "title": "Governance Operations Console runtime observation policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "projection", "product_health", "environment", "components", "activation"],
  "properties": {
    "schema_version": { "const": 1 },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "source_authority", "source_mode", "maximum_age_seconds", "secret_values_allowed"],
      "properties": {
        "schema_version": { "const": "console-runtime-observations/v1" },
        "source_authority": { "const": "platform-engineering" },
        "source_mode": { "const": "live" },
        "maximum_age_seconds": { "type": "integer", "minimum": 30, "maximum": 900 },
        "secret_values_allowed": { "const": false }
      }
    },
    "product_health": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "runtime_activation", "maximum_age_seconds", "inventory_authority", "products", "activation_prerequisites"],
      "properties": {
        "schema_version": { "const": "portfolio-product-runtime-health/v1" },
        "runtime_activation": { "type": "boolean" },
        "maximum_age_seconds": { "type": "integer", "minimum": 30, "maximum": 900 },
        "inventory_authority": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repo", "revision", "path", "sha256"],
          "properties": {
            "repo": { "const": "workspace-governance" },
            "revision": { "$ref": "#/$defs/revision" },
            "path": { "const": "contracts/products.yaml" },
            "sha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "products": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/product" }
        },
        "activation_prerequisites": {
          "type": "object",
          "additionalProperties": false,
          "required": ["security_work_item", "platform_commissioning_work_item"],
          "properties": {
            "security_work_item": { "const": "openproject://work_packages/1271" },
            "platform_commissioning_work_item": { "const": "openproject://work_packages/1273" }
          }
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lane", "profile"],
      "properties": {
        "lane": { "const": "dev-integration" },
        "profile": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/component" }
    },
    "activation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lane", "security_approval_required", "definition_is_security_approval"],
      "properties": {
        "lane": { "const": "dev-integration" },
        "security_approval_required": { "const": true },
        "definition_is_security_approval": { "const": false }
      }
    }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product_id", "product_record_ref", "product_record_version", "platform_owner", "runtime_owner", "component_ids", "recovery"],
      "properties": {
        "product_id": { "type": "string", "pattern": "^product:[a-z0-9][a-z0-9._-]*$" },
        "product_record_ref": { "type": "string", "pattern": "^workspace-governance://products/[a-z0-9][a-z0-9._-]*/v[0-9]+$" },
        "product_record_version": { "type": "integer", "minimum": 1 },
        "platform_owner": { "$ref": "#/$defs/identifier" },
        "runtime_owner": { "$ref": "#/$defs/identifier" },
        "component_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } },
        "recovery": {
          "type": "object",
          "additionalProperties": false,
          "required": ["owner", "runbook_ref"],
          "properties": {
            "owner": { "$ref": "#/$defs/identifier" },
            "runbook_ref": { "type": "string", "pattern": "^(docs|products)/.+\\.md$" }
          }
        }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "category", "workload", "capabilities", "recovery"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "label": { "type": "string", "minLength": 1, "maxLength": 128 },
        "category": { "$ref": "#/$defs/identifier" },
        "workload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "namespace", "name"],
          "properties": {
            "kind": { "enum": ["deployment", "statefulset"] },
            "namespace": { "type": "string", "pattern": "^[a-z0-9{}][a-z0-9{}-]*$" },
            "name": { "$ref": "#/$defs/identifier" }
          }
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "recovery": {
          "type": "object",
          "additionalProperties": false,
          "required": ["owner", "runbook_ref"],
          "properties": {
            "owner": { "const": "platform-engineering" },
            "runbook_ref": { "type": "string", "pattern": "^(docs|products)/.+\\.md$" }
          }
        }
      }
    }
  }
}
