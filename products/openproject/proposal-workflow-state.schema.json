{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workspace-governance.local/platform/openproject/proposal-workflow-state.schema.json",
  "title": "Workspace Proposals Workflow State V1",
  "description": "Versioned machine state persisted in the Proposal Workflow State custom field. Proposal content, lifecycle status, source metadata, and immutable history remain in their existing OpenProject fields and journals.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "route",
    "handoff",
    "last_accepted_command",
    "receipt_refs",
    "updated_at"
  ],
  "properties": {
    "repository_resolution": { "$ref": "#/$defs/repository_resolution" },
    "schema_version": { "const": 1 },
    "route": {
      "oneOf": [
        { "$ref": "#/$defs/route" },
        { "type": "null" }
      ]
    },
    "handoff": { "$ref": "#/$defs/handoff" },
    "last_accepted_command": {
      "oneOf": [
        { "$ref": "#/$defs/accepted_command" },
        { "type": "null" }
      ]
    },
    "receipt_refs": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/identifier" }
    },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+\\-]{0,255}$"
    },
    "nullable_identifier": {
      "oneOf": [
        { "$ref": "#/$defs/identifier" },
        { "type": "null" }
      ]
    },
    "accepted_command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command_id", "command_type", "accepted_at"],
      "properties": {
        "command_id": { "$ref": "#/$defs/identifier" },
        "command_type": { "enum": ["triage", "disposition", "handoff"] },
        "accepted_at": { "type": "string", "format": "date-time" }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "rationale", "source_custody"],
      "properties": {
        "target": { "enum": ["delivery", "prototype"] },
        "rationale": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "source_custody": { "$ref": "#/$defs/source_custody" }
      }
    },
    "source_custody": {
      "oneOf": [
        { "$ref": "#/$defs/existing_repo_custody" },
        { "$ref": "#/$defs/new_repo_custody" },
        { "$ref": "#/$defs/no_repo_custody" }
      ]
    },
    "existing_repo_custody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "repository_mode",
        "repository_gate_state",
        "owner",
        "source_ref",
        "rationale"
      ],
      "properties": {
        "classification": { "const": "existing-repo" },
        "repository_mode": { "const": "existing" },
        "repository_gate_state": { "const": "resolved" },
        "owner": { "$ref": "#/$defs/identifier" },
        "source_ref": { "$ref": "#/$defs/identifier" },
        "rationale": { "type": "string", "minLength": 1, "maxLength": 1000 }
      }
    },
    "new_repo_custody": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "repository_gate_state": { "const": "resolved" }
            },
            "required": ["repository_gate_state"]
          },
          "then": {
            "properties": {
              "owner": { "$ref": "#/$defs/identifier" },
              "source_ref": { "$ref": "#/$defs/identifier" }
            }
          }
        }
      ],
      "required": [
        "classification",
        "repository_mode",
        "repository_gate_state",
        "owner",
        "source_ref",
        "rationale"
      ],
      "properties": {
        "classification": { "const": "new-repo-required" },
        "repository_mode": { "const": "new" },
        "repository_gate_state": { "enum": ["pending", "resolved"] },
        "owner": { "$ref": "#/$defs/nullable_identifier" },
        "source_ref": { "$ref": "#/$defs/nullable_identifier" },
        "rationale": { "type": "string", "minLength": 1, "maxLength": 1000 }
      }
    },
    "no_repo_custody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "repository_mode",
        "repository_gate_state",
        "owner",
        "source_ref",
        "rationale"
      ],
      "properties": {
        "classification": { "enum": ["platform-internal", "non-source-work"] },
        "repository_mode": { "const": "not-required" },
        "repository_gate_state": { "const": "not-required" },
        "owner": { "$ref": "#/$defs/identifier" },
        "source_ref": { "type": "null" },
        "rationale": { "type": "string", "minLength": 1, "maxLength": 1000 }
      }
    },
    "handoff": {
      "oneOf": [
        { "$ref": "#/$defs/unapplied_handoff" },
        { "$ref": "#/$defs/applied_handoff" }
      ]
    },
    "unapplied_handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "packet_ref", "target_receipt_ref", "target_record_ref"],
      "properties": {
        "state": { "enum": ["not-requested", "blocked", "ready", "waiting-on-target"] },
        "packet_ref": { "$ref": "#/$defs/nullable_identifier" },
        "target_receipt_ref": { "type": "null" },
        "target_record_ref": { "type": "null" }
      }
    },
    "applied_handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "packet_ref", "target_receipt_ref", "target_record_ref"],
      "properties": {
        "state": { "const": "applied" },
        "packet_ref": { "$ref": "#/$defs/identifier" },
        "target_receipt_ref": { "$ref": "#/$defs/identifier" },
        "target_record_ref": { "$ref": "#/$defs/identifier" }
      }
    },
    "resolution_identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+\\-]{0,255}$"
    },
    "resolution_artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uri",
        "digest"
      ],
      "properties": {
        "uri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "format": "uri"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "resolution_proposal_id": {
      "type": "string",
      "pattern": "^idea-[1-9][0-9]*$"
    },
    "repository_resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_ref",
        "source_version",
        "proposal_id",
        "repository_request_ref",
        "resolved_owner",
        "resolved_repo_ref",
        "recorded_at",
        "notes",
        "custody_receipt_ref",
        "resolution_id",
        "custody_request_id"
      ],
      "properties": {
        "receipt_ref": {
          "$ref": "#/$defs/resolution_identifier"
        },
        "source_version": {
          "type": "string",
          "pattern": "^version-[0-9]+$"
        },
        "proposal_id": {
          "$ref": "#/$defs/resolution_proposal_id"
        },
        "repository_request_ref": {
          "type": "string",
          "pattern": "^repo-request://proposal/idea-[1-9][0-9]*$"
        },
        "resolved_owner": {
          "$ref": "#/$defs/resolution_identifier"
        },
        "resolved_repo_ref": {
          "$ref": "#/$defs/resolution_identifier"
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        },
        "notes": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "custody_receipt_ref": {
          "$ref": "#/$defs/resolution_artifact_ref"
        },
        "resolution_id": {
          "$ref": "#/$defs/resolution_identifier"
        },
        "custody_request_id": {
          "$ref": "#/$defs/resolution_identifier"
        }
      }
    }
  }
}
