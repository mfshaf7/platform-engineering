{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://platform-engineering.local/security/schemas/delivery-refinement-advice.schema.json",
  "title": "Delivery Refinement provider advice",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "confidence",
    "required_operator_action",
    "field_key",
    "value",
    "summary",
    "rationale"
  ],
  "properties": {
    "confidence": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "required_operator_action": {
      "type": "string",
      "const": "review"
    },
    "field_key": {
      "type": "string"
    },
    "value": {
      "type": ["string", "null"],
      "maxLength": 64000
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "rationale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    }
  }
}
