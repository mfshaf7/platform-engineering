{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://platform-engineering.local/security/schemas/model-profile-lifecycle-decision.schema.json",
  "type": "object",
  "required": [
    "schema_version", "decision_id", "request_id", "request_revision",
    "request_receipt_digest", "intent", "actor_id", "recorded_at",
    "expected_sources", "profile_id", "target_profile",
    "activation_environment", "security_decision_ref", "idempotency_key"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "decision_id": { "type": "string", "pattern": "^platform-model-profile-decision:[A-Za-z0-9._:-]{1,128}$" },
    "request_id": { "type": "string", "pattern": "^model-profile-request:[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "request_revision": { "type": "integer", "minimum": 1 },
    "request_receipt_digest": { "$ref": "#/$defs/digest" },
    "intent": { "enum": ["create", "amend", "activate", "suspend", "retire", "exception"] },
    "actor_id": { "const": "platform-engineering/model-profile-lifecycle" },
    "recorded_at": { "type": "string", "format": "date-time" },
    "expected_sources": {
      "type": "object",
      "required": ["source_version", "registry_digest", "access_plane_digest", "runtime_assist_digest"],
      "properties": {
        "source_version": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "registry_digest": { "$ref": "#/$defs/digest" },
        "access_plane_digest": { "$ref": "#/$defs/digest" },
        "runtime_assist_digest": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    },
    "profile_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
    "target_profile": { "oneOf": [{ "type": "object" }, { "type": "null" }] },
    "activation_environment": { "oneOf": [{ "enum": ["dev-integration", "stage", "prod"] }, { "type": "null" }] },
    "security_decision_ref": { "oneOf": [{ "$ref": "#/$defs/artifactRef" }, { "type": "null" }] },
    "idempotency_key": { "$ref": "#/$defs/identifier" }
  },
  "$defs": {
    "identifier": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "artifactRef": {
      "type": "object",
      "required": ["uri", "digest"],
      "properties": {
        "uri": { "type": "string", "format": "uri" },
        "digest": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
