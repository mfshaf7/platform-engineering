{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Inactive Prototype Closure Identity Definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "identity", "selection", "security_authority", "source_boundary", "secret_custody", "consumer", "activation", "audit", "rollback"],
  "properties": {
    "schema_version": {"const": 1},
    "identity": {
      "type": "object",
      "required": ["id", "provider", "credential_kind", "repository", "repository_selection", "maximum_repository_count", "required_permissions", "maximum_token_lifetime_seconds", "events"],
      "properties": {
        "id": {"const": "prototype-closure-github-app-v1"},
        "provider": {"const": "github"},
        "credential_kind": {"const": "github-app-installation"},
        "repository": {"const": {"full_name": "mfshaf7/workspace-prototype-studio", "id": 1231020532, "owner_id": 244414185, "owner_type": "User"}},
        "repository_selection": {"const": "selected"},
        "maximum_repository_count": {"const": 1},
        "required_permissions": {"const": {"metadata": "read", "contents": "write", "pull_requests": "write", "checks": "read"}},
        "maximum_token_lifetime_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
        "events": {"const": []}
      },
      "additionalProperties": false
    },
    "selection": {"const": {"state": "defined-inactive", "app_id": null, "installation_id": null, "runtime_enabled": false}},
    "security_authority": {"const": {"implementation_review_gate": "openproject://work_packages/1106", "normal_availability_gate": "openproject://work_packages/1140", "review_decision": "pending"}},
    "source_boundary": {
      "type": "object",
      "required": ["allowed_branch_pattern", "allowed_write_paths", "canonical_branch", "merge_authority", "provider_enforcement_required", "denied_actions"],
      "properties": {
        "allowed_branch_pattern": {"const": "^prototype-closure/[0-9a-f]{64}$"},
        "allowed_write_paths": {"const": ["prototypes.yaml", "records/prototype-closures/**"]},
        "canonical_branch": {"const": "main"},
        "merge_authority": {"const": "human-reviewer"},
        "provider_enforcement_required": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "denied_actions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "secret_custody": {
      "type": "object",
      "required": ["authority", "planned_private_key_source", "planned_runtime_projection", "key_commissioned", "token_projected", "values_in_source", "values_in_receipts", "values_in_logs"],
      "properties": {
        "authority": {"const": "platform-engineering"},
        "planned_private_key_source": {"const": {"backend": "vault", "path": "components/operator-orchestration-service/dev-integration/prototype-closure", "property": "privateKey"}},
        "planned_runtime_projection": {"const": {"kind": "kubernetes-secret-volume", "name": "operator-orchestration-service-prototype-closure", "directory": "/var/run/oos/prototype-closure", "mount_read_only": true}},
        "key_commissioned": {"const": false},
        "token_projected": {"const": false},
        "values_in_source": {"const": false},
        "values_in_receipts": {"const": false},
        "values_in_logs": {"const": false}
      },
      "additionalProperties": false
    },
    "consumer": {"const": {"component": "operator-orchestration-service", "runtime_lane": "dev-integration", "allowed_profiles": ["accepted-idea-delivery"], "caller_id": "operator-orchestration-service", "workflow_enabled": false}},
    "activation": {
      "type": "object",
      "required": ["authority_work_item", "security_implementation_gate", "security_normal_availability_gate", "required_evidence", "definition_is_activation", "runtime_enabled"],
      "properties": {
        "authority_work_item": {"const": "openproject://work_packages/1107"},
        "security_implementation_gate": {"const": "openproject://work_packages/1106"},
        "security_normal_availability_gate": {"const": "openproject://work_packages/1140"},
        "required_evidence": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
        "definition_is_activation": {"const": false},
        "runtime_enabled": {"const": false}
      },
      "additionalProperties": false
    },
    "audit": {"type": "object", "required": ["receipt_fields", "receipt_contains_secret_values"], "properties": {"receipt_fields": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true}, "receipt_contains_secret_values": {"const": false}}, "additionalProperties": false},
    "rollback": {
      "type": "object",
      "required": ["suspend_new_requests", "revoke_exact_active_token", "remove_exact_runtime_projection", "retain_workflow_and_review_evidence", "retain_canonical_git_history", "preserve_prototype_landing_identity", "preserve_prototype_maturity_identity", "delete_prototype", "delete_durable_owner_source", "rewrite_main"],
      "properties": {
        "suspend_new_requests": {"const": true},
        "revoke_exact_active_token": {"const": true},
        "remove_exact_runtime_projection": {"const": true},
        "retain_workflow_and_review_evidence": {"const": true},
        "retain_canonical_git_history": {"const": true},
        "preserve_prototype_landing_identity": {"const": true},
        "preserve_prototype_maturity_identity": {"const": true},
        "delete_prototype": {"const": false},
        "delete_durable_owner_source": {"const": false},
        "rewrite_main": {"const": false}
      },
      "additionalProperties": false
    }
  }
}
