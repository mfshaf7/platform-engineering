        "api_base_url": "https://api.github.com",
        "repository": {"full_name": "mfshaf7/workspace-prototype-studio", "id": 1231020532, "owner_id": 244414185, "owner_type": "User"},
        "repository_selection": "selected",
        "maximum_repository_count": 1,
