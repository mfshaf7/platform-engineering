        "wgcf_implementation_ref_env": "WGCF_PROTOTYPE_LANDING_IMPLEMENTATION_REF",
        "wgcf_implementation_ref": "e19a18240a0ac1a5bbea8cceeaccbba4d544cd7b",
        "wgcf_service_identity_ref_env": "WGCF_PROTOTYPE_LANDING_SERVICE_IDENTITY_REF",
        "wgcf_service_identity_ref": "service-identity://workspace-governance-control-fabric/dev-integration"
