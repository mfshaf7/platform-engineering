        "runtime_projection": {"kind": "kubernetes-secret-volume", "name": "operator-orchestration-service-prototype-landing", "token_key": "installation-token", "wgcf_caller_secret_key": "wgcf-caller-secret", "directory": "/var/run/oos/prototype-landing", "token_filename": "installation-token", "mount_read_only": true, "sub_path_allowed": false},
