        "denied_actions": ["merge", "direct-main-write", "force-push", "repository-create", "repository-delete", "repository-administration", "secret-access", "unrelated-repository-access", "wildcard-repository-selection", "referenced-source-mutation", "personal-token", "ambient-gh-credentials"]
