{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://platform-engineering.local/security/schemas/source-editor-assistance.schema.json",
  "title": "Source editor assistance proposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "message",
    "edits"
  ],
  "properties": {
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12000
    },
    "edits": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "content"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "content": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 65536
          }
        }
      }
    }
  }
}
